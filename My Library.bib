@article{casarettDiagnosisManagementDelirium2001,
  title = {Diagnosis and Management of Delirium near the End of Life},
  author = {Casarett, D J and Inouye, S K and {American College of Physicians-American Society of Internal Medicine End-of-Life Care Consensus Panel}},
  date = {2001-07},
  journaltitle = {Ann. Intern. Med.},
  volume = {135},
  number = {1},
  pages = {32--40},
  abstract = {Delirium is a common and distressing symptom that constitutes a significant challenge for end-of-life care. However, reliable techniques are available for the diagnosis of delirium, and effective therapies exist as well. This consensus paper uses a case-based format that begins with an overview of the definition and presentation of delirium. Next, strategies for diagnosis are suggested, with attention to the unique challenges that clinicians face in pursuing a diagnostic work-up for patients near the end of life. The paper concludes with a review of therapeutic options.},
  langid = {english}
}

