LC. Janssen Research and Development LLC are providing non-financial contributions to support this study. P.R.A.S. has received a presentation fee from Indivior and an advisory board fee from LivaNova.},
  langid = {english},
  pmcid = {PMC7613090},
  keywords = {Antidepressive Agents,bipolar disorder,Bipolar Disorder,consensus,Consensus,definition,depression,Depression,Depressive Disorder Major,Depressive Disorder Treatment-Resistant,Humans,Treatment resistant},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@hospitalitaliano.org.ar/My Drive/Papers, cursos y libros/Zotero/DCS Depression/Hidalgo-Mazzei et al_2019_Treatment-resistant and multi-therapy-resistant criteria for bipolar depression.pdf}
}

