@article{Wichers2015,
  title = {Micro-{{Level Affect Dynamics}} in {{Psychopathology Viewed From Complex Dynamical System Theory}}},
  author = {Wichers, M. and Wigman, J. T. W. and Myin-Germeys, I.},
  date = {2015-10-01},
  journaltitle = {Emotion Review},
  volume = {7},
  number = {4},
  pages = {362--367},
  publisher = {SAGE Publications},
  issn = {1754-0739},
  doi = {10.1177/1754073915590623},
  url = {https://doi.org/10.1177/1754073915590623},
  urldate = {2025-03-02},
  abstract = {This article discusses the role of moment-to-moment affect dynamics in mental disorder and aims to integrate recent literature on this topic in the context of complex dynamical system theory. First, we will review the relevance of temporal and contextual aspects of affect dynamics in relation to psychopathology. Related to this, we will discuss recent insights resulting from a network view on affect dynamics in psychopathology. Next, we explore how we can reconcile literature findings from a perspective of complex dynamical system theory. Finally, future directions with regard to personalized assessment of risk and diagnostic use are discussed.},
