  shorttitle = {Predicting Outcome with {{Intranasal Esketamine}} Treatment},
  author = {Pettorruso, Mauro and Guidotti, Roberto and family=Andrea, given=Giacomo, prefix=d', useprefix=true and De Risio, Luisa and D'Andrea, Antea and Chiappini, Stefania and Carullo, Rosalba and Barlati, Stefano and Zanardi, Raffaella and Rosso, Gianluca and De Filippis, Sergio and Di Nicola, Marco and Andriola, Ileana and Marcatili, Matteo and Nicolò, Giuseppe and Martiadis, Vassilis and Bassetti, Roberta and Nucifora, Domenica and De Fazio, Pasquale and Rosenblat, Joshua D. and Clerici, Massimo and Maria Dell'Osso, Bernardo and Vita, Antonio and Marzetti, Laura and Sensi, Stefano L. and Di Lorenzo, Giorgio and McIntyre, Roger S. and Martinotti, Giovanni and {REAL-ESK Study Group}},
  date = {2023-09},
