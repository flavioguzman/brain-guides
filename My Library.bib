@article{forbesDetailedHierarchicalModel2021,
  title = {A {{Detailed Hierarchical Model}} of {{Psychopathology}}: {{From Individual Symptoms}} up to the {{General Factor}} of {{Psychopathology}}},
  shorttitle = {A {{Detailed Hierarchical Model}} of {{Psychopathology}}},
  author = {Forbes, Miriam K. and Sunderland, Matthew and Rapee, Ronald M. and Batterham, Philip J. and Calear, Alison L. and Carragher, Natacha and Ruggero, Camilo and Zimmerman, Mark and Baillie, Andrew J. and Lynch, Samantha J. and Mewton, Louise and Slade, Tim and Krueger, Robert F.},
  date = {2021-03-01},
  journaltitle = {Clinical Psychological Science},
  volume = {9},
  number = {2},
  pages = {139--168},
  publisher = {SAGE Publications Inc},
  issn = {2167-7026},
  doi = {10.1177/2167702620954799},
  url = {https://doi.org/10.1177/2167702620954799},
  urldate = {2024-03-16},
  abstract = {Much of the knowledge about the relationships among domains of psychopathology is built on the diagnostic categories described in the Diagnostic and Statistical Manual of Mental Disorders (DSM), and relatively little research has examined the symptom-level structure of psychopathology. The aim of this study was to delineate a detailed hierarchical model of psychopathology—from individual symptoms up to a general factor of psychopathology—allowing both higher- and lower-order dimensions to depart from the structure of the DSM. We explored the hierarchical structure of hundreds of symptoms spanning 18 DSM disorders in two large samples—one from the general population in Australia (n = 3,175) and the other a treatment-seeking clinical sample from the United States (n = 1,775). There was marked convergence between the two samples, offering new perspectives on higher-order dimensions of psychopathology. We also found several noteworthy departures from the structure of the DSM in the symptom-level data.},
  langid = {english},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@gmail.com/My Drive/Zotero_Library/ResearchRabbit_Export_3_31_2024/Forbes et al_2021_A Detailed Hierarchical Model of Psychopathology.pdf;/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@hospitalitaliano.org.ar/My Drive/Papers, cursos y libros/Zotero/DCS Psicopatología/Forbes et al_2021_A Detailed Hierarchical Model of Psychopathology.pdf;/Users/sebastianmalleza/Zotero/storage/L3R7W8M3/Forbes et al_2021_A Detailed Hierarchical Model of Psychopathology.pdf}
}

