@article{fazzitoPersonalizedFunctionalConnectivity2021,
  title = {Personalized Functional Connectivity Analysis in Responders and Nonresponders to Ketamine and Electroconvulsive Therapy: {{A}} Case Series},
  shorttitle = {Personalized Functional Connectivity Analysis in Responders and Nonresponders to Ketamine and Electroconvulsive Therapy},
  author = {Fazzito, Maria Lucia and Gonzalez, Juan José and Fiorentini, Leticia and Leiman, Marina and Pérez, Adriana and Costanzo, Elsa and Villarreal, Mirta F. and Guinjoan, Salvador M.},
  date = {2021-11},
  journaltitle = {Personalized Medicine in Psychiatry},
  shortjournal = {Personalized Medicine in Psychiatry},
  volume = {29--30},
  pages = {100082},
  issn = {24681717},
  doi = {10.1016/j.pmip.2021.100082},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S2468171721000144},
  urldate = {2022-10-08},
  abstract = {Objective: Major depressive disorder is a common medical problem, frequently resistant to antidepressant treatments. We sought to describe functional connectivity correlates of response and non-response to rapidacting antidepressants in patients with treatment-resistant depression. Methods: We performed an MRI-based, BOLD functional connectivity analysis on three patients with treatmentresistant depression, with varying degrees of response to electroconvulsive therapy (ECT) or intravenous sub­ anesthetic ketamine. Results: Response to treatment was associated with an increase of positive correlations and increased connectivity of bilateral frontal, subcortical, right temporal and right occipital regions. Treatment nonresponse was associated with an increase in negative correlations between frontal lobes and their respective contra- and ipsilateral pa­ rietal and occipital lobes. Conclusion: Response to rapid-acting treatments was associated in this case series to increased functional con­ nectivity, especially in homologous regions of both hemispheres. If replicated in a bigger sample, this correlate of response can provide insights into mechanisms of rapid-acting antidepressant treatment response.},
  langid = {english},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@hospitalitaliano.org.ar/My Drive/Papers, cursos y libros/Zotero/Proyecto Depresión fMRI/Fazzito et al_2021_Personalized functional connectivity analysis in responders and nonresponders.pdf}
}

@article{feczkoHeterogeneityProblemApproaches2019,
  title = {The {{Heterogeneity Problem}}: {{Approaches}} to {{Identify Psychiatric Subtypes}}},
  shorttitle = {The {{Heterogeneity Problem}}},
  author = {Feczko, Eric and Miranda-Dominguez, Oscar and Marr, Mollie and Graham, Alice M. and Nigg, Joel T. and Fair, Damien A.},
  date = {2019-07},
  journaltitle = {Trends in Cognitive Sciences},
  shortjournal = {Trends in Cognitive Sciences},
  volume = {23},
  number = {7},
  pages = {584--601},
  issn = {13646613},
  doi = {10.1016/j.tics.2019.03.009},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1364661319300920},
  urldate = {2022-10-08},
  abstract = {The imprecise nature of psychiatric nosology restricts progress towards characterizing/treating mental health disorders. One issue is the ‘heterogeneity problem’: different causal mechanisms may relate to the same disorder, and multiple outcomes of interest can occur within one individual. Our review tackles this ‘heterogeneity problem’, providing considerations/concepts/approaches for investigators examining human cognition and mental health. We highlight the difficulty of pure dimensional approaches due to ‘the curse of dimensionality’. Computationally, we consider supervised and unsupervised statistical approaches to identify putative subtypes within a population. However, we emphasize that subtype identification should be linked to a particular outcome or question. We conclude with novel hybrid approaches that can identify subtypes tied to outcomes, and may help advance precision diagnostic and treatment tools.},
  langid = {english},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@hospitalitaliano.org.ar/My Drive/Papers, cursos y libros/Zotero/Proyecto Depresión fMRI/Feczko et al_2019_The Heterogeneity Problem.pdf}
}

