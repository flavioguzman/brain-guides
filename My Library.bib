@article{weiPredictionRecurrentSuicidal2021,
  title = {Prediction of Recurrent Suicidal Behavior among Suicide Attempters with {{Cox}} Regression and Machine Learning: A 10-Year Prospective Cohort Study},
  shorttitle = {Prediction of Recurrent Suicidal Behavior among Suicide Attempters with {{Cox}} Regression and Machine Learning},
  author = {Wei, Yan-Xin and Liu, Bao-Peng and Zhang, Jie and Wang, Xin-Ting and Chu, Jie and Jia, Cun-Xian},
  date = {2021-12},
  journaltitle = {Journal of Psychiatric Research},
  shortjournal = {J Psychiatr Res},
  volume = {144},
  eprint = {34700209},
  eprinttype = {pubmed},
  pages = {217--224},
  issn = {1879-1379},
  doi = {10.1016/j.jpsychires.2021.10.023},
  abstract = {BACKGROUND: Research on predictors and risk of recurrence after suicide attempt from China is lacking. This study aims to identify risk factors and develop prediction models for recurrent suicidal behavior among suicide attempters using Cox proportional hazard (CPH) and machine learning methods. METHODS: The prospective cohort study included 1103 suicide attempters with a maximum follow-up of 10 years from rural China. Baseline characteristics, collected by face-to-face interviews at least 1 month later after index suicide attempt, were used to predict recurrent suicidal behavior. CPH and 3 machine learning algorithms, namely, the least absolute shrinkage and selection operator, random survival forest, and gradient boosting decision tree, were used to construct prediction models. Model performance was accessed by concordance index (C-index) and the time-dependent area under the receiver operating characteristic curve (AUC) value for discrimination, and time-dependent calibration curve along with Brier score for calibration. RESULTS: The median follow-up time was 7.79 years, and 49 suicide attempters had recurrent suicidal behavior during the study period. Four models achieved comparably good discrimination and calibration performance, with all C-indexes larger than 0.70, AUC values larger than 0.65, and Brier scores smaller than 0.06. Mental disorder emerged as the most important predictor across all four models. Suicide attempters with mental disorders had a 3 times higher risk of recurrence than those without. History of suicide attempt (HR~=~2.84, 95\% CI: 1.34-6.02), unstable marital status (HR~=~2.81, 95\% CI: 1.38-5.71), and older age (HR~=~1.51, 95\% CI: 1.14-2.01) were also identified as independent predictors of recurrent suicidal behavior by CPH model. CONCLUSIONS: We developed four models to predict recurrent suicidal behavior with comparable good prediction performance. Our findings potentially provided benefits in screening vulnerable individuals on a more precise scale.},
  langid = {english},
  keywords = {Cohort study,Humans,Machine learning,Machine Learning,Prediction,Prospective Studies,Recurrent suicidal behavior,Risk Factors,Suicidal Ideation,Suicide Attempted},
  file = {/Users/sebastianmalleza/Zotero/storage/GY3CBBYU/S0022395621006208.html}
}

@book{weitbrechtManualPsiquiatria1978,
