@article{turaBrainConnectivityMajor2023,
  title = {Brain Connectivity in Major Depressive Disorder: A Precision Component of Treatment Modalities?},
  shorttitle = {Brain Connectivity in Major Depressive Disorder},
  author = {Tura, Asude and Goya-Maldonado, Roberto},
  date = {2023-06-09},
  journaltitle = {Translational Psychiatry},
  shortjournal = {Transl Psychiatry},
  volume = {13},
  number = {1},
  pages = {196},
  issn = {2158-3188},
  doi = {10.1038/s41398-023-02499-y},
  url = {https://www.nature.com/articles/s41398-023-02499-y},
  urldate = {2024-09-29},
  abstract = {Abstract             Major depressive disorder (MDD) is a very prevalent mental disorder that imposes an enormous burden on individuals, society, and health care systems. Most patients benefit from commonly used treatment methods such as pharmacotherapy, psychotherapy, electroconvulsive therapy (ECT), and repetitive transcranial magnetic stimulation (rTMS). However, the clinical decision on which treatment method to use remains generally informed and the individual clinical response is difficult to predict. Most likely, a combination of neural variability and heterogeneity in MDD still impedes a full understanding of the disorder, as well as influences treatment success in many cases. With the help of neuroimaging methods like functional magnetic resonance imaging (fMRI) and diffusion tensor imaging (DTI), the brain can be understood as a modular set of functional and structural networks. In recent years, many studies have investigated baseline connectivity biomarkers of treatment response and the connectivity changes after successful treatment. Here, we systematically review the literature and summarize findings from longitudinal interventional studies investigating the functional and structural connectivity in MDD. By compiling and discussing these findings, we recommend the scientific and clinical community to deepen the systematization of findings to pave the way for future systems neuroscience roadmaps that include brain connectivity parameters as a possible precision component of the clinical evaluation and therapeutic decision.},
  langid = {english},
  keywords = {clave},
  file = {/Users/sebastianmalleza/Zotero/storage/UZ2LTWCG/Tura and Goya-Maldonado - 2023 - Brain connectivity in major depressive disorder a.pdf}
}

@article{tzourio-mazoyerAutomatedAnatomicalLabeling2002,
  title = {Automated Anatomical Labeling of Activations in {{SPM}} Using a Macroscopic Anatomical Parcellation of the {{MNI MRI}} Single-Subject Brain},
  author = {Tzourio-Mazoyer, N and Landeau, B and Papathanassiou, D and Crivello, F and Etard, O and Delcroix, N and Mazoyer, B and Joliot, M},
  date = {2002-01},
  journaltitle = {Neuroimage},
  volume = {15},
  number = {1},
  pages = {273--289},
  abstract = {An anatomical parcellation of the spatially normalized single-subject high-resolution T1 volume provided by the Montreal Neurological Institute (MNI) (D. L. Collins et al., 1998, Trans. Med. Imag. 17, 463-468) was performed. The MNI single-subject main sulci were first delineated and further used as landmarks for the 3D definition of 45 anatomical volumes of interest (AVOI) in each hemisphere. This procedure was performed using a dedicated software which allowed a 3D following of the sulci course on the edited brain. Regions of interest were then drawn manually with the same software every 2 mm on the axial slices of the high-resolution MNI single subject. The 90 AVOI were reconstructed and assigned a label. Using this parcellation method, three procedures to perform the automated anatomical labeling of functional studies are proposed: (1) labeling of an extremum defined by a set of coordinates, (2) percentage of voxels belonging to each of the AVOI intersected by a sphere centered by a set of coordinates, and (3) percentage of voxels belonging to each of the AVOI intersected by an activated cluster. An interface with the Statistical Parametric Mapping package (SPM, J. Ashburner and K. J. Friston, 1999, Hum. Brain Mapp. 7, 254-266) is provided as a freeware to researchers of the neuroimaging community. We believe that this tool is an improvement for the macroscopical labeling of activated area compared to labeling assessed using the Talairach atlas brain in which deformations are well known. However, this tool does not alleviate the need for more sophisticated labeling strategies based on anatomical or cytoarchitectonic probabilistic maps.},
  langid = {english}
}

@article{vandeLeemput2014,
  title = {Critical Slowing down as Early Warning for the Onset and Termination of Depression},
  author = {family=Leemput, given=Ingrid A., prefix=van de, useprefix=true and Wichers, Marieke and Cramer, Angélique O. J. and Borsboom, Denny and Tuerlinckx, Francis and Kuppens, Peter and family=Nes, given=Egbert H., prefix=van, useprefix=true and Viechtbauer, Wolfgang and Giltay, Erik J. and Aggen, Steven H. and Derom, Catherine and Jacobs, Nele and Kendler, Kenneth S. and family=Maas, given=Han L. J., prefix=van der, useprefix=true and Neale, Michael C. and Peeters, Frenk and Thiery, Evert and Zachar, Peter and Scheffer, Marten},
  date = {2014-01-07},
  journaltitle = {Proceedings of the National Academy of Sciences},
  volume = {111},
  number = {1},
  pages = {87--92},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.1312114110},
  url = {https://www.pnas.org/doi/abs/10.1073/pnas.1312114110},
  urldate = {2025-03-02},
  abstract = {About 17\% of humanity goes through an episode of major depression at some point in their lifetime. Despite the enormous societal costs of this incapacitating disorder, it is largely unknown how the likelihood of falling into a depressive episode can be assessed. Here, we show for a large group of healthy individuals and patients that the probability of an upcoming shift between a depressed and a normal state is related to elevated temporal autocorrelation, variance, and correlation between emotions in fluctuations of autorecorded emotions. These are indicators of the general phenomenon of critical slowing down, which is expected to occur when a system approaches a tipping point. Our results support the hypothesis that mood may have alternative stable states separated by tipping points, and suggest an approach for assessing the likelihood of transitions into and out of depression.},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@gmail.com/My Drive/Zotero_Library/Complex Models in Psychopathology/Complex systems/van de Leemput et al_2014_Critical slowing down as early warning for the onset and termination of.pdf}
}

@article{vanwingenShorttermAntidepressantAdministration2014,
  title = {Short-Term Antidepressant Administration Reduces Default Mode and Task-Positive Network Connectivity in Healthy Individuals during Rest},
  author = {family=Wingen, given=Guido A., prefix=van, useprefix=true and Tendolkar, Indira and Urner, Maren and family=Marle, given=Hein J., prefix=van, useprefix=true and Denys, Damiaan and Verkes, Robbert-Jan and Fernández, Guillén},
  date = {2014-03},
  journaltitle = {NeuroImage},
  shortjournal = {NeuroImage},
  volume = {88},
  pages = {47--53},
  issn = {10538119},
  doi = {10.1016/j.neuroimage.2013.11.022},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1053811913011142},
  urldate = {2022-10-10},
  abstract = {Resting-state studies in depressed patients have revealed increased connectivity within the default mode net- 29 work (DMN) and task-positive network (TPN). This has been associated with heightened rumination, which is 30 Q4 the tendency to repetitively think about symptoms of distress. Here, we performed a pharmacological neuroim- 31 aging study in healthy volunteers to investigate whether short-term antidepressant administration could reduce 32 DMN connectivity. We recorded resting-state functional magnetic resonance imaging (fMRI) scans in twenty- 33 three healthy volunteers after two week intake of the combined serotonin–norepinephrine reuptake inhibitor 34 (SNRI) duloxetine in a double-blind, placebo-controlled, crossover study. Duloxetine improved mood in part as 35 a result of increased resilience to the mood-worsening effects of scanning and reduced DMN and TPN connectiv- 36 ity. Within the DMN, duloxetine reduced connectivity between the medial prefrontal cortex (MPFC) and the lat- 37 eral parietal cortex (LPC) and uncoupled the MPFC from the dorsolateral prefrontal cortex (DLPFC). Within the 38 TPN, duloxetine uncoupled the intraparietal sulcus (IPS) from the inferior occipital gyrus. These results show 39 that two-week antidepressant administration reduces DMN and TPN connectivity in healthy volunteers, which 40 may contribute to their antidepressant effects in depression.},
  langid = {english},
  file = {/Users/sebastianmalleza/Library/CloudStorage/GoogleDrive-sebastian.malleza@hospitalitaliano.org.ar/My Drive/Papers, cursos y libros/Zotero/Proyecto Depresión fMRI/Bibliografía fMRI con ATD/van Wingen et al_2014_Short-term antidepressant administration reduces default mode and task-positive.pdf}
}

