@article{ostuzziContinuingReducingSwitching2022,
  title = {Continuing, Reducing, Switching, or Stopping Antipsychotics in Individuals with Schizophrenia-Spectrum Disorders Who Are Clinically Stable: A Systematic Review and Network Meta-Analysis},
