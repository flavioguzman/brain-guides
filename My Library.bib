@article{mittalReviewDeliriumElderly2011,
  title = {Review: Delirium in the Elderly: A Comprehensive Review},
  author = {Mittal, Vikrant and Muralee, Sunanda and Williamson, Deena and McEnerney, Nicole and Thomas, Jennifer and Cash, Mary and Tampi, Rajesh R},
  date = {2011-03},
  journaltitle = {Am. J. Alzheimers. Dis. Other Demen.},
  volume = {26},
  number = {2},
  pages = {97--109},
  abstract = {Delirium is a common neuropsychiatric syndrome in the elderly characterized by concurrent impairments in cognition and behaviors. The etiologies for delirium are often multifactorial and are due to underlying medical illnesses and/or due to medication effect. The diagnosis of delirium is often missed in elderly patients and this condition may be mislabeled as depression or dementia. Untreated, delirium can have devastating consequences in the elderly with high rates of morbidity and mortality. Available evidence indicates that early detection, reduction of risk factors, and better management of this condition can decrease its morbidity rates. In this review, we discuss the etiology, neurobiology, diagnosis, prevention, and treatments for this potentially lethal condition in the elderly.},
  langid = {english}
}

